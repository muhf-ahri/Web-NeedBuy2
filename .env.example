# ─────────────────────────────────────────────────────────────────────────────
# NeedBuy Frontend — contoh konfigurasi
#
# Salin jadi `.env` lalu isi nilainya. JANGAN pernah menaruh nilai asli di
# berkas ini: `.env.example` ikut ke GitHub, `.env` tidak.
#
# PERINGATAN: Vite membakar setiap variabel berawalan VITE_ ke dalam bundle
# JavaScript. Apa pun di berkas ini bisa dibaca siapa saja yang membuka
# devtools di situs yang sudah dideploy. Jangan taruh rahasia apa pun di sini.
# ─────────────────────────────────────────────────────────────────────────────

# Alamat API backend, sudah termasuk /api/v1.
# Lokal    : http://localhost:4000/api/v1
# Produksi : https://<nama-app>.up.railway.app/api/v1
VITE_API_BASE_URL=http://localhost:4000/api/v1

# Midtrans CLIENT key (diawali `Mid-client-` atau `SB-Mid-client-`).
# BUKAN server key. Server key hanya boleh ada di backend.
VITE_MIDTRANS_CLIENT_KEY=
